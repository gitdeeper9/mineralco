# MINERALCO Environment Variables Example
# Mineral Intelligence Network for Equation-of-state Research, Atomic Lattice COmputation
# Version: 1.0.0 | DOI: 10.5281/zenodo.19009597

# ============================================
# Application Settings
# ============================================
MINERALCO_ENV=development
MINERALCO_DEBUG=true
MINERALCO_SECRET_KEY=your-secret-key-here-change-in-production
MINERALCO_LOG_LEVEL=INFO

# ============================================
# Database Configuration
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mineralco
DB_USER=mineralco_user
DB_PASSWORD=changeme
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_TTL=3600

# ============================================
# API Configuration
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RATE_LIMIT=100
API_KEY=your-api-key-here

# ============================================
# Data Sources
# ============================================
MINERAL_DB_PATH=/data/raw/mineral_db.json
SYNCHROTRON_DATA_PATH=/data/raw/synchrotron
RRUFF_DATA_PATH=/data/raw/rruff
NIST_DATA_PATH=/data/raw/nist_crystal

# ============================================
# External API Keys
# ============================================
# For data downloads from external sources
NOAA_API_KEY=
NASA_API_KEY=
ESRF_API_KEY=
APS_API_KEY=

# ============================================
# Deployment
# ============================================
NETLIFY_SITE_ID=your-netlify-site-id
NETLIFY_AUTH_TOKEN=your-netlify-auth-token
PYPI_TOKEN=your-pypi-token
DOCKER_REGISTRY=docker.io
DOCKER_USERNAME=your-docker-username
DOCKER_PASSWORD=your-docker-password

# ============================================
# Monitoring
# ============================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_PASSWORD=admin
SENTRY_DSN=

# ============================================
# Email Configuration (for alerts)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL=admin@mineralco.netlify.app

# ============================================
# Security
# ============================================
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
CORS_ORIGINS=["http://localhost:5000", "https://mineralco.netlify.app"]

# ============================================
# Performance Tuning
# ============================================
NUM_CORES=4
CHUNK_SIZE=1000
CACHE_ENABLED=true
PARALLEL_PROCESSING=true

# ============================================
# Paths
# ============================================
DATA_DIR=/data
OUTPUT_DIR=/output
LOG_DIR=/logs
CONFIG_DIR=/config
MODELS_DIR=/models

# ============================================
# IMPORTANT NOTES
# ============================================
# 1. NEVER commit this file to version control!
# 2. Copy to .env for local development
# 3. Use strong passwords in production
# 4. Rotate secrets regularly
# 5. Use secrets management in production
